# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
AUTH_SECRET="" # generate with: npx auth secret
NEXTAUTH_URL="http://localhost:3000"

# Backblaze B2 (S3-compatible object storage)
B2_ACCOUNT_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""
B2_ENDPOINT="" # e.g. https://s3.us-west-004.backblazeb2.com
B2_REGION="" # e.g. us-west-004
# Public URL for file downloads (Cloudflare in front of B2 bucket)
B2_PUBLIC_URL="" # e.g. https://cdn.yourdomain.com

# Resend (transactional email)
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID="" # monthly Price ID
STRIPE_PRO_YEARLY_PRICE_ID="" # yearly Price ID ($39.99/yr)
# Optional "Support us" one-time payment - a Price with "customer chooses price" (custom_unit_amount) enabled
# If unset, the Support us footer link hides itself automatically
STRIPE_SUPPORT_PRICE_ID=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cron (inactive file cleanup) - any random string, must match Vercel's cron auth
CRON_SECRET=""

# VirusTotal (malware hash check on upload) - free tier at virustotal.com/gui/join-us
# Optional: if unset, the malware check silently fails open (uploads are not blocked)
VIRUSTOTAL_API_KEY=""

# Google OAuth (Sign in with Google) - console.cloud.google.com > APIs & Services > Credentials
# Optional: if unset, the Google sign-in button hides itself automatically
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI file summaries + the AI text adventure (src/lib/deepseek.ts), both powered by
# DeepSeek V4 Flash. OPENROUTER_API_KEY (openrouter.ai/keys) is the primary path -
# same model, 3-5x cheaper than DeepSeek's own direct API since many competing
# hosts of the same open-weight model compete there. DEEPSEEK_API_KEY
# (platform.deepseek.com) is optional and only used to spend down an existing
# pre-paid balance first, falling back to OpenRouter automatically once it runs
# out. Optional: if both are unset, both AI features silently no-op
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""

# Daily Character portrait images (src/lib/image-gen.ts, ~$0.01-0.04/image via Flux).
# Off by default - text, the guess game, and chat all work fully without this, images
# were always a best-effort extra on top. Set to "true" once real traffic makes the
# cost feel worth it.
DAILY_CHARACTER_IMAGES_ENABLED="false"

# Google AdSense (src/app/ad-slot.tsx) - only shown to Free/anonymous viewers, Pro
# is ad-free. Optional: if unset, no AdSense script loads and no ad slots render
# anywhere, so it's safe to deploy this before the AdSense account is approved.
NEXT_PUBLIC_ADSENSE_CLIENT_ID="" # e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_SLOT_FILE_PAGE="" # ad unit ID for the file share page placement
