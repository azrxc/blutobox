generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  FREE
  PRO
}

enum Role {
  USER
  ADMIN
}

enum FileStatus {
  ACTIVE
  REMOVED
}

enum ReportStatus {
  OPEN
  REVIEWED
  REMOVED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  passwordHash    String?
  emailVerified   DateTime?
  role            Role      @default(USER)
  planTier        PlanTier  @default(FREE)
  storageUsedBytes BigInt   @default(0)
  banned          Boolean   @default(false)
  createdAt       DateTime  @default(now())

  referredById      String?
  referredBy        User?    @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         User[]   @relation("Referrals")
  bonusStorageBytes BigInt   @default(0)

  files           File[]
  subscription    Subscription?
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  cancellationFeedback CancellationFeedback[]
  creatorLinks    CreatorLink[]
}

model CreatorLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model File {
  id            String     @id @default(cuid())
  ownerId       String?
  owner         User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  uploaderIp    String
  filename      String
  sizeBytes     BigInt
  mimeType      String
  b2Key         String     @unique
  isNsfw        Boolean    @default(false)
  downloadCount Int        @default(0)
  status        FileStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  lastAccessedAt DateTime  @default(now())
  deletionWarningSentAt DateTime?

  shareLinks    ShareLink[]
  reports       Report[]

  @@index([ownerId])
  @@index([uploaderIp])
}

model ShareLink {
  id           String    @id @default(cuid())
  fileId       String
  file         File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  slug         String    @unique
  expiresAt    DateTime?
  passwordHash String?
  createdAt    DateTime  @default(now())
}

model Report {
  id            String       @id @default(cuid())
  fileId        String
  file          File         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  reporterEmail String
  reason        String
  status        ReportStatus @default(OPEN)
  createdAt     DateTime     @default(now())

  @@index([fileId])
  @@index([status])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String   @unique
  stripeSubscriptionId String?  @unique
  tier                 PlanTier @default(FREE)
  status               String
  cancelAtPeriodEnd    Boolean  @default(false)
  currentPeriodEnd     DateTime?
  billingInterval      String?
  updatedAt            DateTime @updatedAt
}

model CancellationFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String?
  comment   String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model BannedIp {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String
  createdAt DateTime @default(now())
}

// One row per calendar day (UTC, "YYYY-MM-DD"), snapshotted from Redis by the daily
// cron job before that day's counter expires. Powers the admin usage graph - upload
// bytes aren't stored here since those can be computed live from File.createdAt.
model DailyStat {
  date          String   @id
  downloadBytes BigInt   @default(0)
  createdAt     DateTime @default(now())
}
