generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  FREE
  PRO
}

enum Role {
  USER
  ADMIN
}

enum FileStatus {
  ACTIVE
  REMOVED
}

enum ReportStatus {
  OPEN
  REVIEWED
  REMOVED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  passwordHash    String?
  emailVerified   DateTime?
  role            Role      @default(USER)
  planTier        PlanTier  @default(FREE)
  storageUsedBytes BigInt   @default(0)
  banned          Boolean   @default(false)
  createdAt       DateTime  @default(now())

  referredById      String?
  referredBy        User?    @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         User[]   @relation("Referrals")
  bonusStorageBytes BigInt   @default(0)
  bonusCreatorLinks Int      @default(0)

  // Pro branding shown on this creator's file share pages - message is plain text
  // (rendered as JSX text, never dangerouslySetInnerHTML, so no XSS risk), color is
  // validated as a strict 6-digit hex before ever being written into an inline style.
  brandMessage String?
  brandColor   String?

  // One-time, non-recurring Pro access ("day pass" / "week pass") - separate from the
  // real Subscription relation below since a Free user can buy one without ever having
  // a subscription. Effective tier = PRO if planTier is PRO OR this is still in the future.
  proPassExpiresAt DateTime?

  files           File[]
  subscription    Subscription?
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  cancellationFeedback CancellationFeedback[]
  creatorLinks    CreatorLink[]
  bookmarks       Bookmark[]
  adventures      Adventure[]
}

model CreatorLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model File {
  id            String     @id @default(cuid())
  ownerId       String?
  owner         User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  uploaderIp    String
  filename      String
  sizeBytes     BigInt
  mimeType      String
  b2Key         String     @unique
  isNsfw        Boolean    @default(false)
  downloadCount Int        @default(0)
  status        FileStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  lastAccessedAt DateTime  @default(now())
  deletionWarningSentAt DateTime?
  notifyOnDownload   Boolean   @default(false)
  downloadNotifiedAt DateTime?
  maxDownloads       Int?

  // AI-generated summary of file contents (src/lib/ai-summary.ts). Generated on-demand
  // by whoever first clicks "Generate AI summary" on the file page, then cached here so
  // Bluto Box only pays for one DeepSeek call per file - every viewer's click still
  // spends their own daily quota though, cached or not, and the button never
  // auto-reveals this to a later viewer without them clicking it themselves.
  aiSummary            String?   @db.Text
  aiSummaryGeneratedAt DateTime?

  shareLinks    ShareLink[]
  reports       Report[]
  downloadEvents DownloadEvent[]

  @@index([ownerId])
  @@index([uploaderIp])
}

// One row per real download - deliberately no IP/identity captured, just "a download
// happened at this time," so Pro's download-analytics view can show a time distribution
// (downloadCount alone is just a running total, no history of when they happened).
model DownloadEvent {
  id        String   @id @default(cuid())
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([fileId, createdAt])
}

model ShareLink {
  id           String    @id @default(cuid())
  fileId       String
  file         File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  slug         String    @unique
  expiresAt    DateTime?
  passwordHash String?
  createdAt    DateTime  @default(now())

  bookmarks    Bookmark[]
}

// A pure bookmark: saving someone else's share link to your own account for easy
// access later. Doesn't protect the underlying file from expiry/cleanup in any way -
// cascades away automatically if the link or file it points to is ever deleted.
model Bookmark {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, shareLinkId])
  @@index([userId])
}

// A saved AI-driven text adventure. A player can have several (capped per plan
// tier, see MAX_SAVED_ADVENTURES in src/lib/limits.ts) and reopen any of them -
// starting a new one doesn't delete the others, it's a history/save-slot list.
// Logged-in users are tied to their account (works across devices); anonymous
// players are tied to a long-lived cookie token instead (src/lib/adventure-session.ts).
model Adventure {
  id           String    @id @default(cuid())
  ownerId      String?
  owner        User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  anonToken    String?
  scenario     String    @db.Text
  turns        Json
  turnCount    Int       @default(0)
  // Game-like meter (Trust, Health, Sanity, etc. - chosen by the AI to fit the
  // scenario at start time), 0-100, adjusted by the AI each turn based on the
  // player's choice. statGoal says which direction is the win: "high" means 100 is
  // victory and 0 is defeat (e.g. Trust); "low" means the reverse (e.g. Suspicion,
  // where reaching 0 is safety and 100 means getting caught). Hitting either bound
  // ends the story - `won` records which one it was.
  statLabel    String?
  statGoal     String    @default("high")
  statValue    Int       @default(50)
  ended        Boolean   @default(false)
  won          Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastPlayedAt DateTime  @default(now())

  @@index([ownerId])
  @@index([anonToken])
}

model Report {
  id            String       @id @default(cuid())
  fileId        String
  file          File         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  reporterEmail String
  reason        String
  status        ReportStatus @default(OPEN)
  createdAt     DateTime     @default(now())

  @@index([fileId])
  @@index([status])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String   @unique
  stripeSubscriptionId String?  @unique
  tier                 PlanTier @default(FREE)
  status               String
  cancelAtPeriodEnd    Boolean  @default(false)
  currentPeriodEnd     DateTime?
  billingInterval      String?
  updatedAt            DateTime @updatedAt
}

model CancellationFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String?
  comment   String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model BannedIp {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String
  createdAt DateTime @default(now())
}

// One row per calendar day (UTC, "YYYY-MM-DD"), snapshotted from Redis by the daily
// cron job before that day's counter expires. Powers the admin usage graph - upload
// bytes aren't stored here since those can be computed live from File.createdAt.
model DailyStat {
  date          String   @id
  downloadBytes BigInt   @default(0)
  createdAt     DateTime @default(now())
}
